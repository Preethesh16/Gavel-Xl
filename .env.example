# Core services (optional in local demo mode; required for durable production rooms)
# Docker Compose values:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gavel_xi
# REDIS_URL=redis://localhost:6379
DATABASE_URL=
REDIS_URL=

# Football data providers
SPORTMONKS_API_TOKEN=
API_FOOTBALL_KEY=
FOOTBALL_DATA_PROVIDER=demo

# Enrichment and valuation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=5000
VALUATION_PROVIDER=game-estimate
VALUATION_API_KEY=

# Public/runtime URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
# Internal URL used by the Next.js server for read-only result pages.
SERVER_URL=http://localhost:4000
CLIENT_ORIGIN=http://localhost:3000
PORT=4000
NODE_ENV=development

# Leave empty in local development to generate an unpredictable per-process secret.
# Production requires an explicit value: openssl rand -hex 32
SESSION_SECRET=
